.vercel
node_modules
dist
.env

# Android signing — the real keystore lives in ~/.cip-mobile-signing (outside the
# repo). These are belt-and-braces in case one is ever copied in here.
*.jks
*.keystore
keystore.properties

# Release build output
*.aab
*.ipa
*.xcarchive

# PWA output from `npm run mobile:assets` (capacitor-assets emits this by
# default). Nothing consumes it: index.html doesn't link the manifest, and the
# manifest's icon paths are "../icons/..." which point outside public/, so they
# could never resolve in a build. Regenerated on every asset run.
# The real app icons live in ios/ and android/, and their source is assets/.
icons/
public/manifest.webmanifest
